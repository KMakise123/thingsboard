{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/.umi",
      "!**/.umi-production",
      "!**/.umi-test",
      "!**/.umi-test-production",
      "!**/src/services",
      "!**/src/types/tb/openapi",
      "!api",
      "!**/dist",
      "!**/server",
      "!**/public",
      "!**/coverage",
      "!**/node_modules",
      "!biome.json",
      "!tailwind.css",
      "!package-lock.json",
      "!**/.worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noUnknownAtRules": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off",
        "useExhaustiveDependencies": "error"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useValidAnchor": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "javascript": {
    "jsxRuntime": "reactClassic",
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/pages/**"],
                    "message": "src/core is the bottom layer: it must not import @/pages/**, @/access or @/models (issue #8 layering)."
                  }
                ],
                "paths": {
                  "@/access": "src/core is the bottom layer: it must not import @/pages/**, @/access or @/models (issue #8 layering).",
                  "@/models": "src/core is the bottom layer: it must not import @/pages/**, @/access or @/models (issue #8 layering)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/pages/**"],
                    "message": "src/widgets must not import @/pages/** (issue #8 layering); compose widgets upward in pages."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
